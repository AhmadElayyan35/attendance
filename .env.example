# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.
NODE_ENV=production
PORT=3000
# قاعدة البيانات: إما سحابية على Turso (مطلوبة على خطة Render المجانية)...
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# ...أو ملف محلي على قرص دائم (عند ترك DATABASE_URL فارغًا)
DB_PATH=/data/attendance.db

# حساب المدير الأول: يُنشأ عند أول تشغيل فقط، ثم احذف ADMIN_PASSWORD من البيئة.
ADMIN_USERNAME=manager
ADMIN_PASSWORD=
ADMIN_NAME=علي عودة

# أسماء الشركتين عند أول تشغيل (يمكن تعديلها لاحقًا من لوحة المدير)
COMPANY_1_NAME=شركة التيسير
COMPANY_2_NAME=اتحاد مقاولين المياه

# عند التشغيل خلف وكيل عكسي (Caddy/Nginx/Render/Railway) اجعلها 1
TRUST_PROXY=1
# الكوكي آمنة (HTTPS فقط) تلقائيًا عند NODE_ENV=production
# COOKIE_SECURE=1

# حدّ التنبيه على ضعف دقة الموقع بالمتر
ACCURACY_WARN_M=100

# نسخ احتياطي يومي تلقائي (افتراضيًا مجلد backups بجانب قاعدة البيانات، ويحتفظ بآخر 14 نسخة)
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
